{
  "name": "@domainry/knowledge-ui",
  "version": "0.1.0-dev1",
  "private": false,
  "type": "module",
  "main": "./dist/knowledge-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/knowledge-ui.js"
    },
    "./styles.css": "./dist/knowledge-ui.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:app": "vite build --config app/vite.config.ts && node scripts/check-app-bundle-budget.mjs",
    "check": "tsc --noEmit",
    "check:app": "tsc -p tsconfig.app.json --noEmit",
    "test": "npm run check && node --experimental-strip-types --test test/*.test.mjs test/*.test.ts",
    "i18n:extract": "node scripts/extract-knowledge-messages.mjs",
    "i18n:compile": "lingui compile --typescript",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.577.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@ag-grid-community/locale": "36.2.0",
    "@ariakit/react": "0.4.42",
    "@blocknote/ariakit": "0.56.0",
    "@blocknote/core": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@blocknote/xl-multi-column": "0.56.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@formio/js": "5.7.0",
    "@lingui/core": "^5.6.1",
    "@lingui/react": "^5.6.1",
    "@logicflow/core": "2.2.5",
    "@logicflow/extension": "2.3.1",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@univerjs/preset-sheets-conditional-formatting": "1.1.0",
    "@univerjs/preset-sheets-core": "1.1.0",
    "@univerjs/preset-sheets-data-validation": "1.1.0",
    "@univerjs/presets": "1.1.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "bootstrap": "5.3.8",
    "docx-preview": "0.4.0",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "fflate": "0.8.2",
    "hash-wasm": "4.12.0",
    "jspdf": "4.2.1",
    "katex": "0.16.47",
    "mind-elixir": "5.15.1",
    "numfmt": "3.2.6",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "^4.0.1",
    "rxjs": "7.8.2",
    "shiki": "4.5.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.6",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@lingui/cli": "^5.6.1",
    "@lingui/format-json": "^5.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
